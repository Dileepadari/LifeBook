# ---------------------------------------------------------------------------
# Frontend (Vite). In dev the app talks to /api, which vite.config.ts proxies
# to the Express server on :4000 - so this only needs setting when you deploy
# the SPA and the API to different origins.
# ---------------------------------------------------------------------------
VITE_API_URL=

# ---------------------------------------------------------------------------
# Backend only. Never expose these to the browser bundle - anything prefixed
# VITE_ is compiled into public JS. See DEVDOC.md.
# ---------------------------------------------------------------------------

# Signing secret for the app's own HS256 session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A random secret is generated and persisted on first boot if this is unset,
# which is fine for local use but should be set explicitly for a deployment.
LIFEBOOK_JWT_SECRET=

# API port (default 4000) and SQLite location (default server/data/lifebook.sqlite)
PORT=
LIFEBOOK_DB=

# ---------------------------------------------------------------------------
# AI providers - OPTIONAL. LifeBook works with neither of these set: the
# deterministic engine writes real LifePages and insights from your own data.
# Supplying a key upgrades the prose, it never unlocks a feature.
# Keys can also be set per-user in Settings > AI, which takes priority.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
